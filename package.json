{
  "name": "liame",
  "version": "0.0.0",
  "private": true,
  "description": "Liame: agência de marketing com funcionários de IA (monorepo).",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "db:migrate": "node packages/database/dist/cli/migrate.js",
    "db:migrate:test": "node packages/database/dist/cli/migrate.js --url-env TEST_DATABASE_URL_OWNER",
    "openapi": "pnpm --filter @liame/server openapi",
    "openapi:lint": "spectral lint docs/openapi.json --ruleset .spectral.yaml --fail-severity=warn"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
