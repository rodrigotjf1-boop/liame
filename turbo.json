{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_URL_OWNER",
        "LIAME_KEK_LOCAL",
        "LIAME_KEK_VERSION",
        "KEY_PROVIDER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
