    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:"
  },
  "devDependencies": {
    "@liame/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
