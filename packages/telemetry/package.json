{
  "name": "@liame/telemetry",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap do OpenTelemetry (http, undici e pg) para a API, o worker e o Next.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
